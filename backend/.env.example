# --- Application ---
APP_NAME=AI Document Assistant
APP_VERSION=0.1.0
DEBUG=false

# --- Database (PostgreSQL) ---
# Inside docker-compose DATABASE_URL is overridden automatically.
# For local dev without docker point at your own instance:
# DATABASE_URL=postgresql+psycopg2://docassistant:docassistant@localhost:5432/docassistant
DATABASE_URL=postgresql+psycopg2://docassistant:docassistant@db:5432/docassistant
DB_ECHO=false

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# --- File uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_FILES=5
ALLOWED_EXTENSIONS=["pdf", "txt", "docx", "md", "odt"]

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# --- Auth (JWT) ---
# В продакшене обязательно задать свой сильный секрет (>= 32 символов)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- LLM (GigaChat) ---
# Client-credentials OAuth flow (Basic base64(client_id:client_secret))
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GigaChat-Lite | GigaChat-Pro | GigaChat-Max | GigaChat-Ultra | GigaChat
GIGACHAT_MODEL=GigaChat-Max
GIGACHAT_TEMPERATURE=0.2
GIGACHAT_MAX_TOKENS=2048
GIGACHAT_TIMEOUT=60.0
GIGACHAT_TOKEN_TTL_SECONDS=1800
CHAT_TOP_K=5

# --- Agent layer (POST /api/agent) ---
# Ranked chunks per search_documents call, max characters of document text per
# read_document call, and the max tool-call rounds per agent turn.
AGENT_TOP_K=3
AGENT_READ_MAX_CHARS=8000
AGENT_MAX_TOOL_ROUNDS=5

# Bounds for documents the agent may create (validated before any file is made).
AGENT_DOCUMENT_MAX_CHARS=60000
AGENT_DOCUMENT_MAX_SECTIONS=50
AGENT_DOCUMENT_MAX_PARAGRAPHS=200
AGENT_DOCUMENT_MAX_LINE_CHARS=2000
AGENT_DOCUMENT_MAX_LIST_ITEMS=200
AGENT_DOCUMENT_MAX_TABLE_ROWS=100

# --- Metadata-aware RAG ---
# The LLM classifies whether a question needs document metadata; when it does
# not, only chunk text reaches the model (no filename/date/size headers).
# Available metadata fields: original_filename, file_type, file_size,
# content_length, created_at. Page numbers are NOT available.
CHAT_METADATA_CLASSIFIER_ENABLED=true

# --- Web Push (VAPID) ---
# Generate keys: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem().decode()); print(v.public_pem().decode())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@ada.local
